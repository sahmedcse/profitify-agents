{
  "env": {
    "PROFITIFY_ROOT": "/ABSOLUTE/PATH/TO/Profitify"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(/ABSOLUTE/PATH/TO/Profitify/scripts/gate.sh:*)",
      "Bash(/ABSOLUTE/PATH/TO/Profitify/scripts/worktree.sh:*)",
      "Bash(/ABSOLUTE/PATH/TO/Profitify/scripts/verify-gate.sh:*)",
      "Bash(/ABSOLUTE/PATH/TO/Profitify/scripts/contract-check.sh:*)",
      "Bash(/ABSOLUTE/PATH/TO/Profitify/scripts/iter.sh:*)",
      "Bash(/ABSOLUTE/PATH/TO/Profitify/scripts/brief.sh:*)",
      "Bash(/ABSOLUTE/PATH/TO/Profitify/scripts/pr-body.sh:*)",
      "Bash(/ABSOLUTE/PATH/TO/Profitify/scripts/freeport.sh:*)",
      "Bash(bash /ABSOLUTE/PATH/TO/Profitify/scripts/:*)",

      "Bash(git -C /ABSOLUTE/PATH/TO/Profitify/.worktrees/:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree prune:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git show-ref:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git branch --list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",

      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh api repos/:*)",

      "Bash(jq:*)", "Bash(rg:*)", "Bash(shasum:*)", "Bash(cat:*)", "Bash(ls:*)",
      "Bash(head:*)", "Bash(tail:*)", "Bash(sed -n:*)", "Bash(sort:*)", "Bash(comm:*)",
      "Bash(wc:*)", "Bash(mkdir -p:*)", "Bash(date:*)", "Bash(find:*)",

      "Read(//ABSOLUTE/PATH/TO/Profitify/**)",
      "Edit(//ABSOLUTE/PATH/TO/Profitify/.worktrees/**)",
      "Write(//ABSOLUTE/PATH/TO/Profitify/.worktrees/**)",
      "Edit(//ABSOLUTE/PATH/TO/Profitify/.runs/**)",
      "Write(//ABSOLUTE/PATH/TO/Profitify/.runs/**)"
    ],
    "deny": [
      "Edit(//ABSOLUTE/PATH/TO/Profitify/profitify-backend/**)",
      "Edit(//ABSOLUTE/PATH/TO/Profitify/profitify-web/**)",
      "Edit(//ABSOLUTE/PATH/TO/Profitify/profitify-ops/**)",
      "Edit(//ABSOLUTE/PATH/TO/Profitify/profitify-backend-services/**)",
      "Write(//ABSOLUTE/PATH/TO/Profitify/profitify-backend/**)",
      "Write(//ABSOLUTE/PATH/TO/Profitify/profitify-web/**)",
      "Write(//ABSOLUTE/PATH/TO/Profitify/profitify-ops/**)",
      "Write(//ABSOLUTE/PATH/TO/Profitify/profitify-backend-services/**)",
      "Read(//ABSOLUTE/PATH/TO/Profitify/**/.env)",
      "Read(//ABSOLUTE/PATH/TO/Profitify/**/.env.*)",

      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove --force:*)",

      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh repo delete:*)",

      "Bash(aws:*)",
      "Bash(npx cdk deploy:*)",
      "Bash(npx cdk destroy:*)",
      "Bash(cdk deploy:*)",
      "Bash(cdk destroy:*)",

      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)"
    ],
    "ask": [
      "Bash(git worktree remove:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/Profitify/.claude/hooks/guard-main-checkouts.sh"
          }
        ]
      }
    ]
  }
}
